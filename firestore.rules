rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* ================= Users ================= */
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.role == 'candidate'
        && (!('isPremium' in request.resource.data) || request.resource.data.isPremium == false)
        && !('subscriptionPlanId' in request.resource.data);
      allow update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.role == resource.data.role
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'isPremium', 'subscriptionPlanId'
        ]);
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    /* ================= Recruiters ================= */
    match /recruiters/{recruiterId} {
      allow read, write: if request.auth != null
        && request.auth.uid == recruiterId;
    }

    /* ================= Companies ================= */
    match /companies/{companyId} {

      // Everyone logged in can read company profiles
      allow read: if request.auth != null;

      // Only recruiter can manage
      allow create: if request.auth != null
        && request.resource.data.recruiterId == request.auth.uid;

      allow update, delete: if request.auth != null
        && resource.data.recruiterId == request.auth.uid;
    }

    /* ================= Jobs ================= */
    match /jobs/{jobId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    /* ================= Job Applications ================= */
    match /job_applications/{applicationId} {
      allow read, write: if request.auth != null;
    }

    /* ================= Candidates ================= */
    match /candidates/{candidateId} {
      allow read: if request.auth != null && (
        request.auth.uid == candidateId ||
        exists(/databases/$(database)/documents/recruiters/$(request.auth.uid))
      );

      // Clients cannot grant themselves premium or inject trial timestamps on creation
      allow create: if request.auth != null && request.auth.uid == candidateId
        && (!('isPremium' in request.resource.data) || request.resource.data.isPremium == false)
        && !('trialStartDate' in request.resource.data)
        && !('trialExpiryDate' in request.resource.data)
        && !('subscriptionPlanId' in request.resource.data);

      // Clients cannot modify protected billing and trial fields on update
      allow update: if request.auth != null && request.auth.uid == candidateId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'isPremium',
          'hasUsedTrial',
          'trialStartDate',
          'trialExpiryDate',
          'subscriptionExpiryDate',
          'subscriptionStatus',
          'subscriptionPlanId',
          'appleSubscriptionId',
          'razorpaySubscriptionId',
          'razorpayPaymentId',
          'razorpayOrderId'
        ]);
    }

    /* ================= Assessment Results ================= */
    match /assessmentResults/{resultId} {
      // Changed request.query to resource.data.
      // Queries must filter by candidateId for this to pass.
      allow read: if request.auth != null
        && resource.data.candidateId == request.auth.uid;

      allow create: if request.auth != null
        && request.resource.data.candidateId == request.auth.uid;
      
      allow delete: if request.auth != null
        && resource.data.candidateId == request.auth.uid;
    }

    /* ================= Chats ================= */
    match /chats/{chatId} {

      // Allow read/write if the user is a participant
      allow read, write: if request.auth != null && (
        request.auth.uid in resource.data.participantIds
      );

      match /messages/{messageId} {
        allow read, write: if request.auth != null && (
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId))
            .data.participantIds
        );
      }
    }

    /* ================= Notifications ================= */
    match /notifications/{notificationId} {
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null;
    }

    /* ================= Default Deny ================= */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
